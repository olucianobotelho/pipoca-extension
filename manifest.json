{
  "manifest_version": 3,
  "name": "Pipoca — Cronômetro de Projetos",
  "version": "5.2.0",
  "description": "Acompanhe seus projetos, ganhos e peça ajuda contextual à Pipoca.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "activeTab",
    "scripting",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pipoca — tempo e ajuda com projetos",
    "default_icon": {
      "16": "assets/pipoca-16.png",
      "32": "assets/pipoca-32.png",
      "48": "assets/pipoca-48.png",
      "128": "assets/pipoca-128.png"
    }
  },
  "icons": {
    "16": "assets/pipoca-16.png",
    "32": "assets/pipoca-32.png",
    "48": "assets/pipoca-48.png",
    "128": "assets/pipoca-128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob:"
  }
}
